# BankOps AI — environment. Copy to .env and adjust for local use.
# Never commit real secrets.

# --- PostgreSQL ---
POSTGRES_DB=bankops
POSTGRES_USER=bankops
POSTGRES_PASSWORD=change-me-local-only
POSTGRES_PORT=5434

# --- Keycloak ---
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=change-me-local-only
KEYCLOAK_PORT=8180
KEYCLOAK_REALM=bankops
# Issuer URI as the browser and backend see it.
OIDC_ISSUER_URI=http://localhost:8180/realms/bankops

# --- Backend ---
BACKEND_PORT=8080
SPRING_PROFILES_ACTIVE=local
# Audience expected in the JWT.
OIDC_AUDIENCE=bankops-api
# Comma-separated allowed browser origins.
CORS_ALLOWED_ORIGINS=http://localhost:4200,http://127.0.0.1:4200

# --- Frontend ---
FRONTEND_PORT=4200
# Angular runtime configuration (injected at build/run time).
NG_OIDC_AUTHORITY=http://localhost:8180/realms/bankops
NG_OIDC_CLIENT_ID=bankops-frontend
NG_API_BASE_URL=http://localhost:8080/api/v1

# --- MinIO (Phase 2; declared from Phase 1) ---
MINIO_ROOT_USER=bankops
MINIO_ROOT_PASSWORD=change-me-local-only
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001

# --- AI (Phase 3). Leave empty: the default profile uses the deterministic mock. ---
AI_PROVIDER=mock
AI_API_KEY=
AI_MODEL=
AI_BASE_URL=

# Document storage / processing
MINIO_ENDPOINT=http://localhost:9000
MINIO_BUCKET=bankops-documents
DOCUMENT_JOBS_ENABLED=true
